# Copia este archivo como .env.local y ajusta los valores.
# .env.local está ignorado por git y nunca debe subirse (Art. VI.5).

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Con el contenedor de desarrollo (docker compose up -d), este valor sirve tal cual.
DATABASE_URL="postgresql://finzen:finzen_dev@localhost:5433/finzen"

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------
# Cadena aleatoria y larga. Genera una con:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Inteligencia artificial
# ---------------------------------------------------------------------------
# ollama  → modelo local, gratuito, los datos no salen del equipo
# gemini  → API de nube, requiere clave propia
# none    → sin IA: el registro funciona manualmente y todo lo demás igual
#
# Los tres caminos deben funcionar. Si no tienes Ollama instalado, usa "none"
# y la aplicación arranca igual (D-052).
AI_PROVIDER="none"

# Solo si AI_PROVIDER=ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL=""

# Solo si AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=""
